```java
public void addLast(E e) {
  if (e == null)
    throw new NullPointerException();
  final Object[] es = elements;
  es[tail] = e;
  if (head == (tail = inc(tail, es.length)))		// head==tail 扩容
    grow(1);
}

static final int inc(int i, int modulus) {
  if (++i >= modulus) i = 0;
  return i;
}
